# ---------------------------------------------------------------------------
# Public site URL. Must be the real production origin, no trailing slash.
# Used for canonical tags, sitemap.xml, robots.txt and OpenGraph URLs.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------------------------------------------------------------------------
# Job data source.
#   sample  -> ships with the repo, for local development and design work.
#              JobPosting structured data is SUPPRESSED in this mode so that
#              demo listings are never submitted to Google Jobs.
#   adzuna  -> live listings from the Adzuna API (US / GB / CA coverage).
#              Free tier: https://developer.adzuna.com/
# ---------------------------------------------------------------------------
JOB_DATA_SOURCE=sample
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---------------------------------------------------------------------------
# Google AdSense. Leave BLANK until the site is actually approved.
# While blank, no ad script is injected and no ad slots render.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT=

# Google Search Console HTML-tag verification (just the content value)
NEXT_PUBLIC_GSC_VERIFICATION=

# Plausible / GA4 (optional)
NEXT_PUBLIC_GA_ID=
